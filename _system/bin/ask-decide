#!/usr/bin/env node
// ==============================================================================
// ask-decide: Standalone Decision Model CLI (TypeSafe Jev & Microsoft-Decision-1)
// Zero external dependencies. Requires Node.js 18+.
// Reads keys from process.env, ~/.config/decide/credentials.json, or local .env
// ==============================================================================
import { existsSync, readFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";

function loadKeys() {
  let typesafe = process.env.TYPESAFE_API_KEY || "";
  let openrouter = process.env.OPENROUTER_API_KEY || "";

  // 1. Try ~/.config/decide/credentials.json
  const configPath = join(homedir(), ".config", "decide", "credentials.json");
  if (existsSync(configPath)) {
    try {
      const data = JSON.parse(readFileSync(configPath, "utf8"));
      if (!typesafe) typesafe = data.TYPESAFE_API_KEY || "";
      if (!openrouter) openrouter = data.OPENROUTER_API_KEY || "";
    } catch {}
  }

  // 2. Try ~/Projects/decide-mcp/.env
  const mcpEnv = join(homedir(), "Projects", "decide-mcp", ".env");
  if ((!typesafe || !openrouter) && existsSync(mcpEnv)) {
    try {
      for (const line of readFileSync(mcpEnv, "utf8").split("\n")) {
        const trimmed = line.trim();
        if (trimmed.startsWith("TYPESAFE_API_KEY=") && !typesafe) {
          typesafe = trimmed.split("=", 2)[1].trim();
        } else if (trimmed.startsWith("OPENROUTER_API_KEY=") && !openrouter) {
          openrouter = trimmed.split("=", 2)[1].trim();
        }
      }
    } catch {}
  }

  return { typesafe, openrouter };
}

const { typesafe: TYPESAFE_KEY, openrouter: OPENROUTER_KEY } = loadKeys();

const PROVIDERS = {
  typesafe: {
    label: "Jev (TypeSafe System One)",
    key: () => TYPESAFE_KEY,
    url: () => process.env.TYPESAFE_URL || "https://api.typesafe.ai/v1/systemone",
    model: () => process.env.JEV_MODEL || "jev-latest",
  },
  openrouter: {
    label: "OpenRouter Decisions (Decision-1 / Jev)",
    key: () => OPENROUTER_KEY,
    url: () => process.env.OPENROUTER_DECISIONS_URL || "https://openrouter.ai/api/alpha/decisions",
    model: () => process.env.DECISION1_MODEL || "microsoft/microsoft-decision-1",
  },
};

const ALIASES = new Map([
  ["auto", null],
  ["jev", "typesafe"],
  ["typesafe", "typesafe"],
  ["decision1", "openrouter"],
  ["openrouter", "openrouter"],
]);

function resolveProvider(requested) {
  const want = String(requested || "auto").toLowerCase();
  if (!ALIASES.has(want)) throw new Error(`Unknown provider "${requested}". Use auto, jev, or decision1.`);
  let id = ALIASES.get(want);
  if (id === null) {
    if (TYPESAFE_KEY) id = "typesafe";
    else if (OPENROUTER_KEY) id = "openrouter";
    else throw new Error("No decision credentials found in env or ~/.config/decide/credentials.json.");
  }
  return [id, PROVIDERS[id]];
}

function normalizeAnswers(body) {
  if (!body || typeof body !== "object") return null;
  for (const wrapper of ["answers", "data", "result", "decision"]) {
    const inner = body[wrapper];
    if (inner && typeof inner === "object" && inner.answers && typeof inner.answers === "object") {
      return inner.answers;
    }
  }
  if (body.answers && typeof body.answers === "object") return body.answers;
  const keys = Object.keys(body);
  const looksLikeAnswers =
    keys.length > 0 &&
    keys.every((k) => body[k] && typeof body[k] === "object" && typeof body[k].type === "string");
  return looksLikeAnswers ? body : null;
}

async function ask({ provider, model, state, questions, signal }) {
  const [id, impl] = resolveProvider(provider);
  const modelId = model || impl.model();
  const res = await fetch(impl.url(), {
    method: "POST",
    headers: {
      authorization: `Bearer ${impl.key()}`,
      "content-type": "application/json",
      "x-title": "ask-decide",
    },
    body: JSON.stringify({ model: modelId, state, questions }),
    signal,
  });
  const text = await res.text();
  let body;
  try {
    body = JSON.parse(text);
  } catch {
    throw new Error(`${impl.label} returned non-JSON (${res.status}): ${text.slice(0, 300)}`);
  }
  if (!res.ok) throw new Error(`${impl.label} ${res.status}: ${JSON.stringify(body).slice(0, 400)}`);
  const answers = normalizeAnswers(body);
  if (!answers) throw new Error(`${impl.label} returned no answers: ${text.slice(0, 300)}`);
  return { provider: id, model: body.model || modelId, answers, usage: body.usage ?? null };
}

// CLI argument parsing
const args = process.argv.slice(2);

if (args.length === 0 || args.includes("--help") || args.includes("-h")) {
  console.log(`
Usage: ask-decide [options] <question> [state_json]

Options:
  --provider <auto|jev|decision1>   (default: auto)
  --choice <opt1,opt2,...>          Categorical choice question
  --score <crit1,crit2,...>         Ordinal rubric scoring
  --noul                            Yes/No probability question (default)
  --json                            Output raw JSON response

Examples:
  ask-decide "Does this copy claim features not present in the code?" '{"copy":"..."}'
  ask-decide --choice "REACH,REEL,SHIP,ATLAS" "Who should handle this task?" '{"task":"..."}'
`);
  process.exit(0);
}

let provider = "auto";
let mode = "noul";
let options = [];
let outputJson = false;
let questionText = "";
let stateStr = "{}";

let i = 0;
while (i < args.length) {
  const arg = args[i];
  if (arg === "--provider") {
    provider = args[++i];
  } else if (arg === "--choice") {
    mode = "choice";
    options = args[++i].split(",").map((s) => s.trim());
  } else if (arg === "--score") {
    mode = "score";
    options = args[++i].split(",").map((s) => s.trim());
  } else if (arg === "--noul") {
    mode = "noul";
  } else if (arg === "--json") {
    outputJson = true;
  } else if (!questionText) {
    questionText = arg;
  } else if (stateStr === "{}") {
    stateStr = arg;
  }
  i++;
}

if (!questionText) {
  console.error("Error: Missing question text");
  process.exit(1);
}

let state = {};
try {
  state = JSON.parse(stateStr);
} catch {
  state = { text: stateStr };
}

const qPayload = {};
if (mode === "choice") {
  const choiceMap = {};
  for (const opt of options) {
    choiceMap[opt] = opt;
  }
  qPayload["decision"] = {
    type: "choice",
    instructions: questionText,
    criteria: choiceMap,
  };
} else if (mode === "score") {
  qPayload["decision"] = {
    type: "score",
    instructions: questionText,
    criteria: options,
  };
} else {
  qPayload["decision"] = {
    type: "noul",
    instructions: questionText,
  };
}

try {
  const result = await ask({
    provider,
    state,
    questions: qPayload,
    signal: AbortSignal.timeout(12000),
  });
  const decision = result.answers?.decision;

  if (outputJson) {
    console.log(JSON.stringify(result, null, 2));
    process.exit(0);
  }

  if (mode === "choice") {
    console.log(`Choice: ${decision.choice} (confidence: ${(decision.confidence * 100).toFixed(1)}%, provider: ${result.provider})`);
  } else if (mode === "score") {
    console.log(`Score: ${decision.score} [${options[decision.score] || ""}] (confidence: ${(decision.confidence * 100).toFixed(1)}%, provider: ${result.provider})`);
  } else {
    const prob = (decision.noul * 100).toFixed(1);
    const verdict = decision.noul >= 0.5 ? "YES" : "NO";
    console.log(`${verdict} (${prob}% probability, provider: ${result.provider})`);
  }
} catch (err) {
  console.error("Decision call failed:", err.message);
  process.exit(1);
}
